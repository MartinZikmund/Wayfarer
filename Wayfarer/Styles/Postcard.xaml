<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:postcard="using:Wayfarer.Controls.Postcard">

    <!--
        Postcard motif: stamps, postmarks, route lines and the postcard surface. These are decoration, so
        the tones are muted custom colours in Light/Dark; High Contrast maps everything to system colours
        and the purely ornamental parts (airmail stripes, paper sheen) blend into the window colour.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WayfarerStampPaperBrush" Color="#FFFFFDF8" />
            <StaticResource x:Key="WayfarerStampEdgeBrush" ResourceKey="ControlStrongStrokeColorDisabledBrush" />
            <StaticResource x:Key="WayfarerStampLabelBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!-- Every tone is dark in Light and light in Dark, so the accent's on-fill text works on all of them. -->
            <StaticResource x:Key="WayfarerStampArtForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="WayfarerStampAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="WayfarerStampSeaBrush" Color="#FF2F6F8F" />
            <SolidColorBrush x:Key="WayfarerStampMapleBrush" Color="#FFA64B2A" />
            <SolidColorBrush x:Key="WayfarerStampMossBrush" Color="#FF4F6B3A" />
            <SolidColorBrush x:Key="WayfarerStampSandBrush" Color="#FF85662C" />

            <SolidColorBrush x:Key="WayfarerPostmarkInkBrush" Color="#FF56677A" />
            <StaticResource x:Key="WayfarerRouteBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />

            <LinearGradientBrush x:Key="WayfarerPostcardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F7FFFDF8" />
                <GradientStop Offset="1" Color="#EEFAF4E8" />
            </LinearGradientBrush>
            <StaticResource x:Key="WayfarerPostcardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WayfarerPostcardDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="WayfarerAirmailRedBrush" Color="#FFC4473D" />
            <SolidColorBrush x:Key="WayfarerAirmailBlueBrush" Color="#FF2D5B9A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WayfarerStampPaperBrush" Color="#FF34322E" />
            <StaticResource x:Key="WayfarerStampEdgeBrush" ResourceKey="ControlStrongStrokeColorDisabledBrush" />
            <StaticResource x:Key="WayfarerStampLabelBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="WayfarerStampArtForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="WayfarerStampAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="WayfarerStampSeaBrush" Color="#FF8CC4DE" />
            <SolidColorBrush x:Key="WayfarerStampMapleBrush" Color="#FFE7A285" />
            <SolidColorBrush x:Key="WayfarerStampMossBrush" Color="#FFAAC690" />
            <SolidColorBrush x:Key="WayfarerStampSandBrush" Color="#FFDCC08A" />

            <SolidColorBrush x:Key="WayfarerPostmarkInkBrush" Color="#FFA3B3C4" />
            <StaticResource x:Key="WayfarerRouteBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />

            <LinearGradientBrush x:Key="WayfarerPostcardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#16FFF3DC" />
                <GradientStop Offset="1" Color="#0AFFF3DC" />
            </LinearGradientBrush>
            <StaticResource x:Key="WayfarerPostcardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WayfarerPostcardDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="WayfarerAirmailRedBrush" Color="#FFDE7B71" />
            <SolidColorBrush x:Key="WayfarerAirmailBlueBrush" Color="#FF82A8DE" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WayfarerStampPaperBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerStampEdgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WayfarerStampLabelBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WayfarerStampArtForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WayfarerStampAccentBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerStampSeaBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerStampMapleBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerStampMossBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerStampSandBrush" ResourceKey="SystemColorWindowColorBrush" />

            <StaticResource x:Key="WayfarerPostmarkInkBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WayfarerRouteBrush" ResourceKey="SystemColorWindowTextColorBrush" />

            <StaticResource x:Key="WayfarerPostcardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerPostcardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WayfarerPostcardDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <!-- Window colour on window colour: the stripes simply disappear. -->
            <StaticResource x:Key="WayfarerAirmailRedBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerAirmailBlueBrush" ResourceKey="SystemColorWindowColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Motif sizes (4px grid) -->
    <x:Double x:Key="WayfarerStampSmallWidth">48</x:Double>
    <x:Double x:Key="WayfarerStampSmallHeight">56</x:Double>
    <x:Double x:Key="WayfarerStampWidth">64</x:Double>
    <x:Double x:Key="WayfarerStampHeight">76</x:Double>
    <x:Double x:Key="WayfarerStampLargeWidth">88</x:Double>
    <x:Double x:Key="WayfarerStampLargeHeight">104</x:Double>
    <x:Double x:Key="WayfarerPostmarkSize">88</x:Double>
    <x:Double x:Key="WayfarerPostmarkLargeSize">104</x:Double>
    <x:Double x:Key="WayfarerAirmailEdgeHeight">4</x:Double>
    <Thickness x:Key="WayfarerPostcardPadding">20,24,20,20</Thickness>

    <!-- Motif text. Postmark and stamp text is decoration (AccessibilityView Raw); real UI text uses the type ramp. -->
    <Style x:Key="WayfarerPostmarkTextBlockStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <Style x:Key="WayfarerStampLabelTextBlockStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="Clip" />
    </Style>

    <!-- Postcard surface: paper sheen, optional airmail edge, stamp slot top-right. -->
    <Style x:Key="WayfarerPostcardCardStyle" TargetType="postcard:PostcardCard">
        <Setter Property="Background" Value="{ThemeResource WayfarerPostcardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WayfarerPostcardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource WayfarerPostcardPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="postcard:PostcardCard">
                    <Border Background="{TemplateBinding Background}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <postcard:AirmailEdge x:Name="AirmailEdge"
                                                  Height="{StaticResource WayfarerAirmailEdgeHeight}"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.AccessibilityView="Raw"
                                                  Content="{TemplateBinding Stamp}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource WayfarerPostcardCardStyle}" TargetType="postcard:PostcardCard" />

    <!-- Dashed route paths for anything drawn by hand, e.g. a map. -->
    <Style x:Key="WayfarerRoutePathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource WayfarerRouteBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="3,3" />
        <Setter Property="StrokeDashCap" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

</ResourceDictionary>
