<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Only brushes WinUI has no equivalent for live here; everything else uses the WinUI theme brushes directly,
        which already carry their own High Contrast values.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- The scrim sits on photos, not on the app surface, so it stays dark in both themes. -->
            <LinearGradientBrush x:Key="WayfarerPhotoScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="Transparent" />
                <GradientStop Offset="0.35" Color="{StaticResource SystemChromeBlackMediumColor}" />
                <GradientStop Offset="1" Color="{StaticResource SystemChromeBlackHighColor}" />
            </LinearGradientBrush>
            <!-- White over the scrim: TextOnAccent is white in Light, TextFillColorPrimary is white in Dark. -->
            <StaticResource x:Key="WayfarerPhotoCaptionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="WayfarerPhotoScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="Transparent" />
                <GradientStop Offset="0.35" Color="{StaticResource SystemChromeBlackMediumColor}" />
                <GradientStop Offset="1" Color="{StaticResource SystemChromeBlackHighColor}" />
            </LinearGradientBrush>
            <StaticResource x:Key="WayfarerPhotoCaptionForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- High Contrast drops the gradient for an opaque system surface. -->
            <StaticResource x:Key="WayfarerPhotoScrimBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WayfarerPhotoCaptionForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
