<UserControl x:Class="Wayfarer.Controls.Postcard.RouteLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40"
             AutomationProperties.AccessibilityView="Raw"
             IsHitTestVisible="False"
             IsTabStop="False">

    <Canvas x:Name="Surface">
        <Path x:Name="Trail" Style="{StaticResource WayfarerRoutePathStyle}" />
        <Ellipse x:Name="StartDot"
                 Width="8"
                 Height="8"
                 Fill="{ThemeResource WayfarerRouteBrush}" />
        <Ellipse x:Name="EndDot"
                 Width="8"
                 Height="8"
                 Stroke="{ThemeResource WayfarerRouteBrush}"
                 StrokeThickness="2" />
        <FontIcon x:Name="Marker"
                  Width="24"
                  Height="24"
                  FontSize="{StaticResource WayfarerRouteMarkerGlyphSize}"
                  Foreground="{ThemeResource WayfarerRouteBrush}"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  IsTextScaleFactorEnabled="False"
                  RenderTransformOrigin="0.5,0.5">
            <FontIcon.RenderTransform>
                <RotateTransform x:Name="MarkerRotation" />
            </FontIcon.RenderTransform>
        </FontIcon>
    </Canvas>
</UserControl>
