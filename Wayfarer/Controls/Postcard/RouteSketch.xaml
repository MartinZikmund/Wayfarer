<UserControl x:Class="Wayfarer.Controls.Postcard.RouteSketch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AccessibilityView="Raw"
             IsHitTestVisible="False"
             IsTabStop="False">

    <Canvas>
        <Path x:Name="Trail" Style="{StaticResource WayfarerRoutePathStyle}" />
        <Ellipse x:Name="StartDot"
                 Width="8"
                 Height="8"
                 Fill="{ThemeResource WayfarerRouteBrush}" />
        <Ellipse x:Name="EndDot"
                 Width="8"
                 Height="8"
                 Stroke="{ThemeResource WayfarerRouteBrush}"
                 StrokeThickness="2" />
    </Canvas>
</UserControl>
