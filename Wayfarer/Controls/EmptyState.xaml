<UserControl x:Class="Wayfarer.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource WayfarerContentSpacing}">
        <ContentPresenter x:Name="ArtPresenter"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw"
                          Content="{x:Bind Art, Mode=OneWay}"
                          Visibility="Collapsed" />
        <FontIcon x:Name="GlyphIcon"
                  HorizontalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  Style="{StaticResource WayfarerEmptyStateGlyphStyle}" />
        <TextBlock Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{x:Bind Title, Mode=OneWay}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock HorizontalAlignment="Center"
                   Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                   Text="{x:Bind Message, Mode=OneWay}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <ContentPresenter Margin="0,8,0,0"
                          HorizontalAlignment="Center"
                          Content="{x:Bind Action, Mode=OneWay}" />
    </StackPanel>
</UserControl>
