<UserControl x:Class="Wayfarer.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False"
             SizeChanged="OnSizeChanged">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="{StaticResource WayfarerTightSpacing}">
            <TextBlock AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource WayfarerPageTitleTextBlockStyle}"
                       Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                       Text="{x:Bind Subtitle, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ContentPresenter x:Name="AccentPresenter"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw"
                          Content="{x:Bind Accent, Mode=OneWay}"
                          IsHitTestVisible="False" />

        <ContentPresenter Grid.Column="2"
                          VerticalAlignment="Center"
                          Content="{x:Bind Actions, Mode=OneWay}" />
    </Grid>
</UserControl>
