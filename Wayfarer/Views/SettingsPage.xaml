<Page x:Class="Wayfarer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:postcard="using:Wayfarer.Controls.Postcard"
      xmlns:vm="using:Wayfarer.ViewModels"
      AutomationProperties.AutomationId="SettingsPage">

    <ScrollViewer>
        <Grid Padding="{StaticResource WayfarerPagePadding}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WidthStates">
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ThemeRow.RowSpacing" Value="12" />
                            <Setter Target="ThemeComboBox.(Grid.Row)" Value="1" />
                            <Setter Target="ThemeComboBox.(Grid.Column)" Value="1" />
                            <Setter Target="ThemeComboBox.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="641" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource WayfarerContentMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="Settings"
                                 Margin="{StaticResource WayfarerPageHeaderMargin}"
                                 Subtitle="Make Wayfarer feel like home.">
            </controls:PageHeader>

            <StackPanel Grid.Row="1">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- Appearance -->
                <TextBlock Style="{StaticResource WayfarerFirstSectionHeaderTextBlockStyle}" Text="Appearance" />
                <Border Style="{StaticResource WayfarerSettingsRowStyle}">
                    <Grid x:Name="ThemeRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Glyph="&#xE790;"
                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeLabel" Text="App theme" />
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                       Text="Select which app theme to display."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="2"
                                  MinWidth="160"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="ThemeComboBox"
                                  AutomationProperties.LabeledBy="{x:Bind ThemeLabel}"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeSystemItem" Content="System" />
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeLightItem" Content="Light" />
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeDarkItem" Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Rendering -->
                <TextBlock Style="{StaticResource WayfarerSectionHeaderTextBlockStyle}" Text="Rendering" />
                <Border Style="{StaticResource WayfarerSettingsRowStyle}">
                    <!-- Values are LabeledBy their label, so a screen reader reads each pair as one stop. -->
                    <Grid ColumnSpacing="16" RowSpacing="{StaticResource WayfarerContentSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Grid.RowSpan="4"
                                  VerticalAlignment="Top"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Glyph="&#xE7F4;"
                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />

                        <TextBlock x:Name="RendererLabel"
                                   Grid.Column="1"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                   Text="Renderer" />
                        <TextBlock Grid.Column="2"
                                   AutomationProperties.AutomationId="RendererText"
                                   AutomationProperties.LabeledBy="{x:Bind RendererLabel}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.Rendering.Renderer}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="PlatformLabel"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                   Text="Platform" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   AutomationProperties.AutomationId="PlatformText"
                                   AutomationProperties.LabeledBy="{x:Bind PlatformLabel}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.Rendering.Platform}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="RuntimeLabel"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                   Text=".NET runtime" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   AutomationProperties.AutomationId="RuntimeText"
                                   AutomationProperties.LabeledBy="{x:Bind RuntimeLabel}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.Rendering.Runtime}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="UnoVersionLabel"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                   Text="Uno Platform" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   AutomationProperties.AutomationId="UnoVersionText"
                                   AutomationProperties.LabeledBy="{x:Bind UnoVersionLabel}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.Rendering.UnoVersion}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- About -->
                <TextBlock Style="{StaticResource WayfarerSectionHeaderTextBlockStyle}" Text="About" />
                <postcard:PostcardCard AutomationProperties.AutomationId="AboutPostcard">
                    <postcard:PostcardCard.Stamp>
                        <Grid Width="128">
                            <postcard:PostageStamp HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   ImageSource="ms-appx:///Assets/Images/app_logo.png"
                                                   Label="7.0"
                                                   Tilt="4" />
                            <!-- Cancels the stamp, as a real postmark would. -->
                            <postcard:Postmark Margin="0,48,0,0"
                                               HorizontalAlignment="Left"
                                               Date="{x:Bind helpers:Format.Today()}"
                                               Place="Prague"
                                               Tilt="-12"
                                               Waves="None" />
                        </Grid>
                    </postcard:PostcardCard.Stamp>
                    <StackPanel Spacing="{StaticResource WayfarerSectionSpacing}">
                        <StackPanel Spacing="{StaticResource WayfarerContentSpacing}">
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}">
                                <Run Text="Wayfarer · Version" />
                                <Run Text="{x:Bind ViewModel.AppVersion}" />
                            </TextBlock>
                            <TextBlock AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       Text="Greetings from Uno Platform 7.0"
                                       TextWrapping="Wrap" />
                            <TextBlock MaxWidth="{StaticResource WayfarerReadingMaxWidth}"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                       Text="Written once in C# and XAML, then sent to Windows, macOS, Linux, the web, Android, iOS and Apple TV. Here's what we packed."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsRepeater AutomationProperties.AutomationId="FeatureList" ItemsSource="{x:Bind ViewModel.Features}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill"
                                                   MinColumnSpacing="12"
                                                   MinItemWidth="280"
                                                   MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FeatureInfo">
                                    <Grid Padding="12"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          ColumnSpacing="12"
                                          CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Top"
                                                  AutomationProperties.AccessibilityView="Raw"
                                                  Glyph="{x:Bind Glyph}"
                                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource WayfarerTightSpacing}">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                                       Text="{x:Bind Description}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Wish you were here." />
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                       Text="Photos from Unsplash via Lorem Picsum. The trips are made up; the views are real."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </postcard:PostcardCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
