<UserControl x:Class="Wayfarer.Views.EntryWindowContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Wayfarer.Views"
             AutomationProperties.AutomationId="EntryWindowRoot">

    <!-- ThemeResource here, so the background follows this window's RequestedTheme rather than the app's. -->
    <Grid Padding="{StaticResource WayfarerCompactPagePadding}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <views:JournalEntryEditor x:Name="EntryEditor" />
    </Grid>
</UserControl>
