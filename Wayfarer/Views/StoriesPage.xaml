<Page x:Class="Wayfarer.Views.StoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:models="using:Wayfarer.Models"
      AutomationProperties.AutomationId="StoriesPage"
      SizeChanged="OnPageSizeChanged">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderStates">
                <VisualState x:Name="WideHeader" />
                <!-- Controls wrap under the title, and the headline steps down to the page-title size. -->
                <VisualState x:Name="NarrowHeader">
                    <VisualState.Setters>
                        <Setter Target="StoryControls.(Grid.Row)" Value="1" />
                        <Setter Target="StoryControls.(Grid.Column)" Value="0" />
                        <Setter Target="StoryControls.HorizontalAlignment" Value="Left" />
                        <Setter Target="StoryTitle.Style" Value="{StaticResource TitleTextBlockStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Code can't resolve a ThemeResource for this page's theme (only the app's), so XAML hands the story builder its accent. -->
        <Border x:Name="AccentBrushProbe"
                Background="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Visibility="Collapsed" />
        <ScrollViewer Padding="{StaticResource WayfarerPagePadding}"
                      AutomationProperties.AutomationId="StoriesScrollViewer"
                      Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasStory), Mode=OneWay}">
            <StackPanel Spacing="{StaticResource WayfarerSectionSpacing}">

                <Grid ColumnSpacing="{StaticResource WayfarerItemSpacing}"
                      RowSpacing="{StaticResource WayfarerItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                        <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="Stories" />
                        <TextBlock x:Name="StoryTitle"
                                   AutomationProperties.AutomationId="StoryTitle"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   Text="{x:Bind ViewModel.SelectedTrip.Title, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <RichTextBlock x:Name="BylineText"
                                       AutomationProperties.AutomationId="StoryByline"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="StoryControls"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="{StaticResource WayfarerItemSpacing}">
                        <ComboBox MinWidth="200"
                                  AutomationProperties.AutomationId="StoryTripPicker"
                                  AutomationProperties.Name="Trip"
                                  DisplayMemberPath="Title"
                                  ItemsSource="{x:Bind ViewModel.Trips, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTrip, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="HighlightPlacesToggle"
                                      IsOn="{x:Bind ViewModel.HighlightPlaces, Mode=TwoWay}"
                                      OffContent="Highlight places"
                                      OnContent="Highlight places" />
                    </StackPanel>
                </Grid>

                <Rectangle Style="{StaticResource WayfarerDividerStyle}" />

                <Grid x:Name="Columns"
                      HorizontalAlignment="Stretch"
                      ColumnSpacing="{StaticResource WayfarerSectionSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Column0" Width="*" />
                        <ColumnDefinition x:Name="Column1" Width="*" />
                        <ColumnDefinition x:Name="Column2" Width="*" />
                    </Grid.ColumnDefinitions>

                    <RichTextBlock x:Name="StoryText"
                                   AutomationProperties.AutomationId="StoryText"
                                   IsTextSelectionEnabled="True"
                                   OverflowContentTarget="{x:Bind Overflow1}"
                                   TextWrapping="Wrap" />
                    <RichTextBlockOverflow x:Name="Overflow1"
                                           Grid.Column="1"
                                           OverflowContentTarget="{x:Bind Overflow2}" />
                    <RichTextBlockOverflow x:Name="Overflow2"
                                           Grid.Column="2" />
                </Grid>

                <StackPanel Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.StoryPhotos.Count), Mode=OneWay}">
                    <TextBlock Style="{StaticResource WayfarerSectionHeaderTextBlockStyle}" Text="Photos from this story" />
                    <ItemsRepeater AutomationProperties.AutomationId="StoryPhotos"
                                   AutomationProperties.Name="Photos from this story"
                                   ItemsSource="{x:Bind ViewModel.StoryPhotos, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill"
                                               MinColumnSpacing="12"
                                               MinItemWidth="240"
                                               MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Photo">
                                <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                                    <Border Height="160"
                                            AutomationProperties.Name="{x:Bind Caption}"
                                            Style="{StaticResource WayfarerPhotoFrameStyle}">
                                        <Image Source="{x:Bind helpers:Format.Image(ImageUri)}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                               Text="{x:Bind Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:EmptyState Title="No stories yet"
                             Glyph="{x:Bind models:Glyphs.Stories}"
                             Message="Add a trip and its journal entries will show up here as a story."
                             Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasStory), Mode=OneWay}" />
    </Grid>
</Page>
