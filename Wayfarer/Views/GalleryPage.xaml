<Page x:Class="Wayfarer.Views.GalleryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:models="using:Wayfarer.Models"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:postcard="using:Wayfarer.Controls.Postcard"
      xmlns:vm="using:Wayfarer.ViewModels"
      AutomationProperties.AutomationId="GalleryPage"
      SizeChanged="OnPageSizeChanged">

    <Page.Resources>
        <DataTemplate x:Key="PhotoTemplate" x:DataType="vm:GalleryItem">
            <ItemContainer AutomationProperties.AutomationId="GalleryPhotoItem"
                           AutomationProperties.Name="{x:Bind Photo.Caption}"
                           GotFocus="OnTileGotFocus"
                           LostFocus="OnTileLostFocus"
                           PointerCanceled="OnTilePointerExited"
                           PointerEntered="OnTilePointerEntered"
                           PointerExited="OnTilePointerExited"
                           ToolTipService.ToolTip="{x:Bind Photo.Caption}">
                <Grid CornerRadius="{StaticResource ControlCornerRadius}">
                    <Image Source="{x:Bind helpers:Format.Image(Photo.ImageUri)}"
                           Stretch="UniformToFill" />
                    <Border Padding="12,40,12,8"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource WayfarerPhotoScrimBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WayfarerPhotoCaptionTextBlockStyle}"
                                       Text="{x:Bind Photo.Caption}" />
                            <TextBlock Foreground="{ThemeResource WayfarerPhotoCaptionForegroundBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind Photo.Location}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <postcard:PostageStamp Width="{StaticResource WayfarerStampSmallWidth}"
                                           Height="{StaticResource WayfarerStampSmallHeight}"
                                           Margin="8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Glyph="{x:Bind models:Glyphs.Trip}"
                                           Label="{x:Bind Trip.Code}"
                                           Opacity="0"
                                           Tilt="6"
                                           Tone="{x:Bind Trip.StampTone}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource WayfarerPagePadding}"
          RowDefinitions="Auto,Auto,*">
        <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneTime}"
                             Grid.Row="0"
                             Margin="{StaticResource WayfarerPageHeaderWithFiltersMargin}"
                             Subtitle="{x:Bind ViewModel.Summary, Mode=OneWay}"
                             SubtitleAutomationId="GallerySummary">
        </controls:PageHeader>

        <SelectorBar x:Name="TripFilter"
                     Grid.Row="1"
                     Margin="0,0,0,8"
                     AutomationProperties.AutomationId="GalleryTripFilter"
                     SelectionChanged="OnTripFilterChanged">
            <SelectorBarItem x:Name="AllTripsItem"
                             AutomationProperties.AutomationId="GalleryFilterAll"
                             IsSelected="True"
                             Text="All" />
        </SelectorBar>

        <ItemsView x:Name="PhotosView"
                   Grid.Row="2"
                   AutomationProperties.AutomationId="GalleryItemsView"
                   AutomationProperties.Name="Photos"
                   IsItemInvokedEnabled="True"
                   ItemInvoked="OnPhotoInvoked"
                   ItemTemplate="{StaticResource PhotoTemplate}"
                   ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                   SelectionMode="None">
            <ItemsView.Layout>
                <LinedFlowLayout x:Name="PhotoLayout"
                                 ItemsInfoRequested="OnItemsInfoRequested"
                                 ItemsJustification="Start"
                                 ItemsStretch="Fill"
                                 LineHeight="220"
                                 LineSpacing="8"
                                 MinItemSpacing="8" />
            </ItemsView.Layout>
        </ItemsView>

        <controls:EmptyState Title="No photos yet"
                             Grid.Row="2"
                             Glyph="&#xE8B9;"
                             Message="Snap a few on your next trip and they'll pin themselves up here."
                             Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}" />

        <ProgressRing Grid.Row="2"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Loading photos"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</Page>
