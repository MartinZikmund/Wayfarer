<Page x:Class="Wayfarer.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:models="using:Wayfarer.Models"
      xmlns:postcard="using:Wayfarer.Controls.Postcard"
      AutomationProperties.AutomationId="MapPage">

    <!-- Stub: the page builder replaces the body; keep the header, padding and ViewModel conventions. -->
    <Grid Padding="{StaticResource WayfarerPagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource WayfarerContentMaxWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneTime}"
                             Margin="{StaticResource WayfarerPageHeaderMargin}"
                             Subtitle="{x:Bind ViewModel.Subtitle, Mode=OneTime}">
            <controls:PageHeader.Accent>
                <postcard:PostageStamp Glyph="{x:Bind models:Glyphs.Routes}"
                                       Label="Route"
                                       Tilt="-4" />
            </controls:PageHeader.Accent>
            <controls:PageHeader.Actions>
                <ComboBox MinWidth="200"
                          AutomationProperties.AutomationId="RouteTripPicker"
                          AutomationProperties.Name="Trip"
                          DisplayMemberPath="Title"
                          ItemsSource="{x:Bind ViewModel.Trips, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedTrip, Mode=TwoWay}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <postcard:PostcardCard Grid.Row="1"
                               AutomationProperties.AutomationId="RouteCard"
                               Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.Stops.Count), Mode=OneWay}">
            <postcard:PostcardCard.Stamp>
                <postcard:PostageStamp ImageSource="{x:Bind helpers:Format.Image(ViewModel.SelectedTrip.CoverPhoto.ImageUri), Mode=OneWay}"
                                       Label="{x:Bind ViewModel.SelectedTrip.Code, Mode=OneWay}"
                                       Tilt="3"
                                       Tone="{x:Bind ViewModel.SelectedTrip.StampTone, Mode=OneWay}" />
            </postcard:PostcardCard.Stamp>
            <Grid RowSpacing="{StaticResource WayfarerItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{x:Bind ViewModel.SelectedTrip.Title, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <postcard:RouteLine Grid.Row="1"
                                    Width="320"
                                    HorizontalAlignment="Left"
                                    Glyph="{x:Bind models:Glyphs.Routes}" />
                <ListView Grid.Row="2"
                          AutomationProperties.AutomationId="RouteStopsList"
                          AutomationProperties.Name="Route stops"
                          ItemsSource="{x:Bind ViewModel.Stops, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RouteStop">
                            <StackPanel Padding="0,8,0,8" Spacing="{StaticResource WayfarerTightSpacing}">
                                <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}">
                                    <Run Text="Day" />
                                    <Run Text="{x:Bind Day}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind helpers:Format.Date(Date)}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </postcard:PostcardCard>

        <controls:EmptyState Title="No routes yet"
                             Grid.Row="1"
                             Glyph="{x:Bind models:Glyphs.Routes}"
                             Message="Pick a trip and we'll trace where it took you."
                             Visibility="{x:Bind helpers:Format.VisibleIfNone(ViewModel.Stops.Count), Mode=OneWay}" />
    </Grid>
</Page>
