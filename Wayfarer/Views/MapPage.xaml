<Page x:Class="Wayfarer.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:models="using:Wayfarer.Models"
      xmlns:postcard="using:Wayfarer.Controls.Postcard"
      AutomationProperties.AutomationId="MapPage"
      SizeChanged="OnPageSizeChanged">

    <Page.Resources>
        <Style x:Key="WayfarerStopButtonStyle"
               BasedOn="{StaticResource DefaultButtonStyle}"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="64" />
        </Style>
        <Style x:Key="WayfarerSelectedStopButtonStyle"
               BasedOn="{StaticResource AccentButtonStyle}"
               TargetType="Button">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="64" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource WayfarerPagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource WayfarerContentMaxWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneTime}"
                             Margin="{StaticResource WayfarerPageHeaderMargin}"
                             Subtitle="{x:Bind ViewModel.Subtitle, Mode=OneTime}">
            <controls:PageHeader.Accent>
                <postcard:PostageStamp Glyph="{x:Bind models:Glyphs.Routes}"
                                       Label="Route"
                                       Tilt="-4" />
            </controls:PageHeader.Accent>
        </controls:PageHeader>

        <SelectorBar x:Name="TripSelector"
                     Grid.Row="1"
                     Margin="0,0,0,16"
                     HorizontalAlignment="Left"
                     AutomationProperties.AutomationId="RouteTripSelector"
                     AutomationProperties.Name="Trip"
                     SelectionChanged="OnTripSelectionChanged" />

        <ScrollViewer x:Name="ContentScroller"
                      Grid.Row="2"
                      SizeChanged="OnContentSizeChanged"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ContentGrid"
                  Margin="0,0,0,8"
                  ColumnSpacing="16"
                  RowSpacing="16"
                  Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.Stops.Count), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PanelColumn" Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <postcard:PostcardCard x:Name="MapCard"
                                       Height="440"
                                       Padding="0,4,0,0"
                                       AutomationProperties.AutomationId="RouteCard"
                                       AutomationProperties.Name="Route map">
                    <Grid x:Name="MapArea"
                          SizeChanged="OnMapSizeChanged"
                          XYFocusKeyboardNavigation="Enabled">
                        <Border x:Name="BrushProbe"
                                Background="{ThemeResource WayfarerRouteBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Path x:Name="Contours"
                              AutomationProperties.AccessibilityView="Raw"
                              IsHitTestVisible="False"
                              Opacity="0.8"
                              Stroke="{ThemeResource WayfarerPostcardDividerBrush}"
                              StrokeThickness="1" />
                        <Path x:Name="GridLines"
                              AutomationProperties.AccessibilityView="Raw"
                              IsHitTestVisible="False"
                              Opacity="0.6"
                              Stroke="{ThemeResource WayfarerPostcardDividerBrush}"
                              StrokeDashArray="2,4"
                              StrokeThickness="1" />
                        <Border x:Name="RouteHost"
                                AutomationProperties.AccessibilityView="Raw"
                                IsHitTestVisible="False" />
                        <Canvas x:Name="FlightLayer"
                                AutomationProperties.AccessibilityView="Raw"
                                IsHitTestVisible="False">
                            <FontIcon x:Name="Plane"
                                      AutomationProperties.AccessibilityView="Raw"
                                      Width="24"
                                      Height="24"
                                      Foreground="{ThemeResource WayfarerRouteBrush}"
                                      Glyph="&#xE709;"
                                      IsTextScaleFactorEnabled="False" />
                        </Canvas>
                        <Canvas x:Name="StopsLayer" />
                    </Grid>
                </postcard:PostcardCard>

                <postcard:PostcardCard x:Name="DetailCard"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="RouteDetailCard"
                                       ShowAirmailEdge="False">
                    <postcard:PostcardCard.Stamp>
                        <postcard:PostageStamp x:Name="TripStamp"
                                               Width="{StaticResource WayfarerStampSmallWidth}"
                                               Height="{StaticResource WayfarerStampSmallHeight}"
                                               ImageSource="{x:Bind helpers:Format.Image(ViewModel.SelectedTrip.CoverPhoto.ImageUri), Mode=OneWay}"
                                               Label="{x:Bind ViewModel.SelectedTrip.Code, Mode=OneWay}"
                                               Tilt="3"
                                               Tone="{x:Bind ViewModel.SelectedTrip.StampTone, Mode=OneWay}" />
                    </postcard:PostcardCard.Stamp>
                    <StackPanel Spacing="{StaticResource WayfarerItemSpacing}">
                        <StackPanel Spacing="{StaticResource WayfarerContentSpacing}"
                                    Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasSelectedStop), Mode=OneWay}">
                            <TextBlock AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.SelectedTrip.Title, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTrip.Destination, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedTrip.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock AutomationProperties.AutomationId="RouteHint"
                                       Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                       Text="Pick a stamp on the map to see what happened there."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel AutomationProperties.AutomationId="RouteStopDetails"
                                    Spacing="{StaticResource WayfarerContentSpacing}"
                                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasSelectedStop), Mode=OneWay}">
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="{x:Bind ViewModel.SelectedStopCaption, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="RouteStopName"
                                       AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.SelectedStop.Name, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <TextBlock MaxLines="5"
                                       Text="{x:Bind ViewModel.SelectedStop.Entry.Excerpt, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                            <Image MaxHeight="180"
                                   HorizontalAlignment="Left"
                                   AutomationProperties.Name="{x:Bind ViewModel.SelectedPhoto.Caption, Mode=OneWay}"
                                   Source="{x:Bind helpers:Format.Image(ViewModel.SelectedPhoto.ImageUri), Mode=OneWay}"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasSelectedPhoto), Mode=OneWay}" />
                            <HyperlinkButton Padding="0"
                                             AutomationProperties.AutomationId="RouteReadEntryLink"
                                             Command="{x:Bind ViewModel.ReadEntryCommand}"
                                             Content="Read entry"
                                             Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasSelectedEntry), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </postcard:PostcardCard>
            </Grid>
        </ScrollViewer>

        <controls:EmptyState Title="No routes yet"
                             Grid.Row="2"
                             Glyph="{x:Bind models:Glyphs.Routes}"
                             Message="Pick a trip and we'll trace where it took you."
                             Visibility="{x:Bind helpers:Format.VisibleIfNone(ViewModel.Stops.Count), Mode=OneWay}" />
    </Grid>
</Page>
