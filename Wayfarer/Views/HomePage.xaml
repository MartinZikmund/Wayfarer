<Page x:Class="Wayfarer.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:models="using:Wayfarer.Models"
      xmlns:postcard="using:Wayfarer.Controls.Postcard"
      AutomationProperties.AutomationId="HomePage">

    <!-- Stub: the page builder replaces the body; keep the header, padding and ViewModel conventions. -->
    <ScrollViewer>
        <Grid Padding="{StaticResource WayfarerPagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource WayfarerContentMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneTime}"
                                 Margin="{StaticResource WayfarerPageHeaderMargin}"
                                 Subtitle="{x:Bind ViewModel.Subtitle, Mode=OneTime}">
                <controls:PageHeader.Accent>
                    <postcard:Postmark AnimateOnLoad="True"
                                       Date="{x:Bind helpers:Format.Today()}"
                                       Place="Wayfarer"
                                       Waves="Left" />
                </controls:PageHeader.Accent>
            </controls:PageHeader>

            <StackPanel Grid.Row="1" Spacing="{StaticResource WayfarerSectionSpacing}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <postcard:PostcardCard AutomationProperties.AutomationId="HomeGreetingCard"
                                       Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.Trips.Count), Mode=OneWay}">
                    <postcard:PostcardCard.Stamp>
                        <postcard:PostageStamp Width="{StaticResource WayfarerStampLargeWidth}"
                                               Height="{StaticResource WayfarerStampLargeHeight}"
                                               ImageSource="{x:Bind helpers:Format.Image(ViewModel.LatestTrip.CoverPhoto.ImageUri), Mode=OneWay}"
                                               Label="{x:Bind ViewModel.LatestTrip.Code, Mode=OneWay}"
                                               Tilt="4"
                                               Tone="{x:Bind ViewModel.LatestTrip.StampTone, Mode=OneWay}" />
                    </postcard:PostcardCard.Stamp>
                    <StackPanel Spacing="{StaticResource WayfarerContentSpacing}">
                        <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="Greetings from" />
                        <TextBlock AutomationProperties.HeadingLevel="Level2"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Text="{x:Bind ViewModel.LatestTrip.Title, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                                   Text="{x:Bind ViewModel.LatestTrip.Destination, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock MaxWidth="{StaticResource WayfarerReadingMaxWidth}"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.LatestTrip.Summary, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <postcard:RouteLine Width="320"
                                            Margin="0,8,0,8"
                                            HorizontalAlignment="Left"
                                            AnimateOnLoad="True" />
                        <Button AutomationProperties.AutomationId="HomeReadStoryButton"
                                Command="{x:Bind ViewModel.OpenTripCommand}"
                                CommandParameter="{x:Bind ViewModel.LatestTrip, Mode=OneWay}"
                                Content="Read the story"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </postcard:PostcardCard>

                <controls:EmptyState Title="No trips yet"
                                     Glyph="{x:Bind models:Glyphs.Home}"
                                     Message="Every journey starts somewhere. Add a trip and it'll land here."
                                     Visibility="{x:Bind helpers:Format.VisibleIfNone(ViewModel.Trips.Count), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
