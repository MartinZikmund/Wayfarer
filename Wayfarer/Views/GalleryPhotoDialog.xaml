<ContentDialog x:Class="Wayfarer.Views.GalleryPhotoDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:helpers="using:Wayfarer.Helpers"
               xmlns:postcard="using:Wayfarer.Controls.Postcard"
               AutomationProperties.AutomationId="GalleryPhotoDialog"
               CloseButtonText="Close"
               DefaultButton="Close"
               Style="{StaticResource DefaultContentDialogStyle}"
               Title="{x:Bind Photo.Caption, Mode=OneTime}">

    <StackPanel Spacing="{StaticResource WayfarerItemSpacing}">
        <Border MaxHeight="440"
                Style="{StaticResource WayfarerPhotoFrameStyle}">
            <Image AutomationProperties.AutomationId="GalleryDetailImage"
                   AutomationProperties.Name="{x:Bind Photo.Caption, Mode=OneTime}"
                   Source="{x:Bind helpers:Format.Image(Photo.ImageUri), Mode=OneTime}"
                   Stretch="Uniform" />
        </Border>

        <Grid ColumnSpacing="{StaticResource WayfarerItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource WayfarerContentSpacing}">
                    <FontIcon AutomationProperties.AccessibilityView="Raw"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Glyph="&#xE707;"
                              Style="{StaticResource WayfarerIconStyle}" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Photo.Location, Mode=OneTime}" />
                </StackPanel>
                <TextBlock Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                           Text="{x:Bind TripTitle, Mode=OneTime}" />
                <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                           Text="{x:Bind helpers:Format.Date(Photo.TakenOn), Mode=OneTime}" />
                <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                           Text="{x:Bind Credit, Mode=OneTime}" />
            </StackPanel>
            <!-- Echoes the location and date above, so it stays out of the automation tree. -->
            <postcard:Postmark x:Name="PhotoPostmark"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               AnimateOnLoad="True"
                               Caption="{x:Bind TripCode, Mode=OneTime}"
                               Date="{x:Bind Photo.TakenOn, Mode=OneTime}"
                               Diameter="{StaticResource WayfarerPostmarkLargeSize}"
                               Place="{x:Bind Photo.Location, Mode=OneTime}"
                               Waves="None" />
        </Grid>
    </StackPanel>
</ContentDialog>
