<UserControl x:Class="Wayfarer.Views.MomentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:Wayfarer.Helpers"
             xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
             xmlns:postcard="using:Wayfarer.Controls.Postcard"
             xmlns:vm="using:Wayfarer.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="ItineraryStopTemplate" x:DataType="vm:ItineraryStop">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="2"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind helpers:Format.CollapsedIf(IsLast)}" />
                <Border Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="16">
                    <FontIcon AutomationProperties.AccessibilityView="Raw"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              Glyph="{x:Bind Glyph}"
                              Style="{StaticResource WayfarerIconStyle}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Padding="0,0,0,16"
                            Spacing="{StaticResource WayfarerTightSpacing}">
                    <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}">
                        <Run Text="{x:Bind Day}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind helpers:Format.Date(Date)}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Title}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                               Text="{x:Bind Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatCardStyle"
               BasedOn="{StaticResource WayfarerSettingsRowStyle}"
               TargetType="Border">
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource WayfarerCardStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <!-- Below this a side-by-side hero leaves too little room for the text, so it stacks. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Hero.RowSpacing" Value="12" />
                        <Setter Target="Details.(Grid.Row)" Value="1" />
                        <Setter Target="Details.(Grid.Column)" Value="0" />
                        <Setter Target="Details.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Artwork.Width" Value="160" />
                        <Setter Target="Artwork.Height" Value="160" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="{StaticResource WayfarerSectionSpacing}">

            <!-- Hero -->
            <Grid x:Name="Hero" ColumnSpacing="{StaticResource WayfarerSectionSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="Artwork"
                      Width="200"
                      Height="200"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      CornerRadius="{StaticResource OverlayCornerRadius}">
                    <AnimatedVisualPlayer x:Name="Player"
                                          AutomationProperties.AutomationId="{x:Bind Moment.Trip.Id, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind Moment.Trip.Title, Mode=OneWay}"
                                          AutoPlay="False"
                                          Stretch="UniformToFill">
                        <lottie:LottieVisualSource UriSource="{x:Bind Moment.AnimationSource, Mode=OneWay}" />
                    </AnimatedVisualPlayer>
                    <Button Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="PlaybackButton"
                            AutomationProperties.Name="{x:Bind Moment.PlaybackName, Mode=OneWay}"
                            Command="{x:Bind Moment.TogglePlaybackCommand, Mode=OneWay}"
                            Style="{StaticResource WayfarerOverlayButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Moment.PlaybackName, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind Moment.PlaybackGlyph, Mode=OneWay}" Style="{StaticResource WayfarerIconStyle}" />
                    </Button>
                    <postcard:PostageStamp Width="{StaticResource WayfarerStampSmallWidth}"
                                           Height="{StaticResource WayfarerStampSmallHeight}"
                                           Margin="8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           ImageSource="{x:Bind helpers:Format.Image(Moment.Trip.CoverPhoto.ImageUri), Mode=OneWay}"
                                           Label="{x:Bind Moment.Trip.Code, Mode=OneWay}"
                                           Tilt="5"
                                           Tone="{x:Bind Moment.Trip.StampTone, Mode=OneWay}" />
                </Grid>

                <StackPanel x:Name="Details"
                            Grid.Column="1"
                            Spacing="{StaticResource WayfarerContentSpacing}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{x:Bind Moment.Trip.Title, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource WayfarerSecondaryTextBlockStyle}"
                               Text="{x:Bind TripLine(Moment), Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Moment.Trip.Summary, Mode=OneWay}" TextWrapping="Wrap" />

                    <Grid Margin="0,8,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- A determinate ring has no track by default; its Background draws one. -->
                        <ProgressRing Width="56"
                                      Height="56"
                                      AutomationProperties.AutomationId="TripCompletionRing"
                                      AutomationProperties.Name="{x:Bind Moment.CapturedSummary, Mode=OneWay}"
                                      Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                      IsIndeterminate="False"
                                      Maximum="100"
                                      Minimum="0"
                                      Value="{x:Bind Moment.CapturedPercent, Mode=OneWay}" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource WayfarerTightSpacing}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Moment.CapturedSummary, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                       Text="{x:Bind Moment.CapturedDetail, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}"
                                       Text="{x:Bind Moment.JournalSummary, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <Grid ColumnSpacing="{StaticResource WayfarerContentSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                        <FontIcon HorizontalAlignment="Left"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Glyph="&#xE707;"
                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Distance(Moment), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="Distance" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                        <FontIcon HorizontalAlignment="Left"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Glyph="&#xE787;"
                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Duration(Moment), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="Duration" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="{StaticResource WayfarerTightSpacing}">
                        <FontIcon HorizontalAlignment="Left"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Glyph="&#xE8B9;"
                                  Style="{StaticResource WayfarerSettingsGlyphStyle}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind PhotoCount(Moment), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource WayfarerCaptionSecondaryTextBlockStyle}" Text="Captured" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Itinerary -->
            <StackPanel>
                <TextBlock Style="{StaticResource WayfarerFirstSectionHeaderTextBlockStyle}" Text="Itinerary" />
                <ItemsRepeater ItemTemplate="{StaticResource ItineraryStopTemplate}" ItemsSource="{x:Bind Moment.Itinerary, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
