<Page x:Class="Wayfarer.Views.MomentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wayfarer.Controls"
      xmlns:helpers="using:Wayfarer.Helpers"
      xmlns:views="using:Wayfarer.Views"
      xmlns:vm="using:Wayfarer.ViewModels"
      AutomationProperties.AutomationId="MomentsPage">

    <ScrollViewer>
        <!-- Shared page frame: left-aligned at the page padding, content capped by the star column. -->
        <Grid Padding="{StaticResource WayfarerPagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource WayfarerContentMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="{x:Bind ViewModel.Title, Mode=OneTime}"
                                 Margin="{StaticResource WayfarerPageHeaderMargin}"
                                 Subtitle="Each trip at a glance: the miles, the days and the bits you caught.">
            </controls:PageHeader>

            <StackPanel Grid.Row="1" Spacing="{StaticResource WayfarerItemSpacing}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <InfoBar AutomationProperties.AutomationId="MomentsTip"
                         IsClosable="True"
                         IsOpen="True"
                         Message="Pause any animation from its corner. Every day you journal nudges its trip closer to complete."
                         Severity="Informational"
                         Title="Travel tip" />

                <ProgressRing Width="32"
                              Height="32"
                              HorizontalAlignment="Center"
                              AutomationProperties.Name="Loading trips"
                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />

                <ItemsRepeater AutomationProperties.AutomationId="MomentsList" ItemsSource="{x:Bind ViewModel.Moments}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="{StaticResource WayfarerSectionSpacing}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TripMoment">
                            <views:MomentCard Moment="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <controls:EmptyState Title="No trips yet"
                                     Glyph="&#xE81C;"
                                     Message="Your first adventure will land here, stats, timeline and all."
                                     Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.ShowEmpty), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
